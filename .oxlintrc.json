{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "unicorn",
    "oxc",
    "jsx-a11y"
  ],
  "categories": {
    "correctness": "warn"
  },
  "env": {
    "browser": true
  },
  "settings": {
    "react": {
      "version": "18.3"
    }
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn"
  },
  "ignorePatterns": [
    "dist/**",
    "node_modules/**"
  ]
}
